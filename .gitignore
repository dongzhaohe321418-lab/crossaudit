# Python bytecode (never commit: it was tracked until 2026-07-31 and desynced
# from source across interpreter versions)
__pycache__/
*.py[cod]

# Editable-install metadata (pip install -e .)
*.egg-info/
build/
dist/

# Run outputs written into the tree by the reference implementation
/checks.json
**/checks.json

# LaTeX build products — scoped to paper dirs so that *.log fixtures under
# experiment/v3/partC/fixtures/ stay tracked.
# crossaudit.pdf is the raw pdflatex output of crossaudit.tex; the tracked
# record of the build is crossaudit-paper.pdf (see paper/FIGURES.md)
/paper/crossaudit.pdf
/paper/*.aux
/paper/*.log
/paper/*.out
/paper/*.toc
/paper/*.synctex.gz
/paper/*.fls
/paper/*.fdb_latexmk
/paper/submissions/**/*.aux
/paper/submissions/**/*.log
/paper/submissions/**/*.out
/paper/submissions/**/*.synctex.gz

# Credentials — keys live in ~/.crossaudit-keys.env, never in the tree
*.env
.env.*
!*.env.example

# OS noise
.DS_Store

# Build artefacts
/dist/

# local read-only clones of the science repos (never committed)
pv-science/
pv-audit/
